<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><contributor><authoring_tool>BeamDeck (generated)</authoring_tool></contributor>
    <unit name="meter" meter="1"/><up_axis>Z_UP</up_axis></asset>
  <library_effects><effect id="beamdeck_tv_screen-effect"><profile_COMMON><technique sid="common"><lambert>
    <diffuse><color>0 0 0 1</color></diffuse></lambert></technique></profile_COMMON></effect></library_effects>
  <library_materials><material id="beamdeck_tv_screen-material" name="beamdeck_tv_screen">
    <instance_effect url="#beamdeck_tv_screen-effect"/></material></library_materials>
  <library_geometries><geometry id="BeamDeckTVscreen-mesh" name="BeamDeckTVscreen"><mesh>
    <source id="BeamDeckTVscreen-pos"><float_array id="BeamDeckTVscreen-pos-array" count="12">-0.2260 -0.2175 0.1275 0.2260 -0.2175 0.1275 0.2260 -0.2175 0.4875 -0.2260 -0.2175 0.4875</float_array>
      <technique_common><accessor source="#BeamDeckTVscreen-pos-array" count="4" stride="3">
        <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
    <source id="BeamDeckTVscreen-nrm"><float_array id="BeamDeckTVscreen-nrm-array" count="3">0 -1 0</float_array>
      <technique_common><accessor source="#BeamDeckTVscreen-nrm-array" count="1" stride="3">
        <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
    <source id="BeamDeckTVscreen-uv"><float_array id="BeamDeckTVscreen-uv-array" count="8">0 0 1 0 1 1 0 1</float_array>
      <technique_common><accessor source="#BeamDeckTVscreen-uv-array" count="4" stride="2">
        <param name="S" type="float"/><param name="T" type="float"/></accessor></technique_common></source>
    <vertices id="BeamDeckTVscreen-vtx"><input semantic="POSITION" source="#BeamDeckTVscreen-pos"/></vertices>
    <triangles material="beamdeck_tv_screen-material" count="2">
      <input semantic="VERTEX" source="#BeamDeckTVscreen-vtx" offset="0"/>
      <input semantic="NORMAL" source="#BeamDeckTVscreen-nrm" offset="1"/>
      <input semantic="TEXCOORD" source="#BeamDeckTVscreen-uv" offset="2" set="0"/>
      <p>0 0 0 1 0 1 2 0 2 0 0 0 2 0 2 3 0 3</p></triangles>
  </mesh></geometry></library_geometries>
  <library_visual_scenes><visual_scene id="Scene" name="Scene">
    <node id="BeamDeckTVscreen" name="BeamDeckTVscreen" type="NODE">
      <instance_geometry url="#BeamDeckTVscreen-mesh" name="BeamDeckTVscreen"><bind_material><technique_common>
        <instance_material symbol="beamdeck_tv_screen-material" target="#beamdeck_tv_screen-material">
          <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/></instance_material>
      </technique_common></bind_material></instance_geometry>
    </node></visual_scene></library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
